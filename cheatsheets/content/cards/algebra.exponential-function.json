[
  {
    "id": "algebra.exponential-function.basics",
    "topicId": "algebra.exponential-function",
    "title": {
      "ru": "Показательная функция",
      "en": "Exponential function",
      "tj": "Функсияи нишондиҳандагӣ"
    },
    "blocks": [
      {
        "type": "text",
        "markdown": {
          "ru": "**Показательная функция** $y = a^x$ ($a>0$, $a\\neq 1$). При $a>1$ возрастает, при $0<a<1$ убывает. Всегда $y>0$.",
          "en": "An **exponential function** $y = a^x$ ($a>0$, $a\\neq 1$). Increases if $a>1$, decreases if $0<a<1$. Always $y>0$.",
          "tj": "**Функсияи нишондиҳандагӣ** $y = a^x$ ($a>0$, $a\\neq 1$). Ҳангоми $a>1$ меафзояд, ҳангоми $0<a<1$ кам мешавад. Ҳамеша $y>0$."
        }
      },
      {
        "type": "example",
        "problem": {
          "ru": "Решите $2^x = 8$.",
          "en": "Solve $2^x = 8$.",
          "tj": "Ҳал кунед $2^x = 8$."
        },
        "solution": [
          {
            "type": "text",
            "markdown": {
              "ru": "Приведём к одному основанию: $8 = 2^3$.",
              "en": "Use the same base: $8 = 2^3$.",
              "tj": "Ба як асос меорем: $8 = 2^3$."
            }
          },
          {
            "type": "formula",
            "latex": "2^x = 2^3 \\;\\Rightarrow\\; x = 3"
          }
        ]
      }
    ]
  }
]