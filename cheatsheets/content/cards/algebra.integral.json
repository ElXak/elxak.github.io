        "solution": [
          {
            "type": "text",
            "markdown": {
              "ru": "Первообразная $\\dfrac{x^3}{3}$, берём $F(1)-F(0)$.",
              "en": "Antiderivative $\\dfrac{x^3}{3}$, take $F(1)-F(0)$.",
              "tj": "Ибтидоӣ $\\dfrac{x^3}{3}$, $F(1)-F(0)$-ро мегирем."
            }
          },
