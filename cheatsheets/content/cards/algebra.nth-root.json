[
  {
    "id": "algebra.nth-root.basics",
    "topicId": "algebra.nth-root",
    "title": {
      "ru": "Корень n-й степени",
      "en": "nth root",
      "tj": "Решаи дараҷаи n"
    },
    "blocks": [
      {
        "type": "text",
        "markdown": {
          "ru": "**Корень $n$-й степени** из $a$ — число, $n$-я степень которого равна $a$. Обозначают $\\sqrt[n]{a}$.",
          "en": "The **nth root** of $a$ is a number whose $n$-th power equals $a$. Written $\\sqrt[n]{a}$.",
          "tj": "**Решаи дараҷаи $n$** аз $a$ — ададе, ки дараҷаи $n$-уми он ба $a$ баробар аст. $\\sqrt[n]{a}$ ишора мешавад."
        }
      },
      {
        "type": "formula",
        "latex": "\\sqrt[n]{a^m} = a^{m/n}",
        "caption": {
          "ru": "Связь с дробной степенью",
          "en": "Link to fractional powers",
          "tj": "Алоқа бо дараҷаи касрӣ"
        }
      },
      {
        "type": "example",
        "problem": {
          "ru": "Упростите $\\sqrt[3]{54}$.",
          "en": "Simplify $\\sqrt[3]{54}$.",
          "tj": "Содда кунед $\\sqrt[3]{54}$."
        },
        "solution": [
          {
            "type": "text",
            "markdown": {
              "ru": "$54 = 27\\cdot 2$, а $\\sqrt[3]{27} = 3$.",
              "en": "$54 = 27\\cdot 2$, and $\\sqrt[3]{27} = 3$.",
              "tj": "$54 = 27\\cdot 2$, ва $\\sqrt[3]{27} = 3$."
            }
          },
          {
            "type": "formula",
            "latex": "\\sqrt[3]{54} = 3\\sqrt[3]{2}"
          }
        ]
      }
    ]
  }
]