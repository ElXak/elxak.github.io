[
  {
    "id": "algebra.special-products.basics",
    "topicId": "algebra.special-products",
    "title": {
      "ru": "Формулы сокращённого умножения",
      "en": "Special product formulas",
      "tj": "Формулаҳои зарби мухтасар"
    },
    "blocks": [
      {
        "type": "text",
        "markdown": {
          "ru": "Эти формулы ускоряют умножение и разложение на множители.",
          "en": "These formulas speed up multiplication and factoring.",
          "tj": "Ин формулаҳо зарб ва ҷудокунӣ ба зарбкунандаҳоро метезонанд."
        }
      },
      {
        "type": "formula",
        "latex": "(a+b)^2 = a^2 + 2ab + b^2",
        "caption": {
          "ru": "Квадрат суммы",
          "en": "Square of a sum",
          "tj": "Квадрати ҷамъ"
        }
      },
      {
        "type": "formula",
        "latex": "(a-b)^2 = a^2 - 2ab + b^2",
        "caption": {
          "ru": "Квадрат разности",
          "en": "Square of a difference",
          "tj": "Квадрати фарқ"
        }
      },
      {
        "type": "formula",
        "latex": "(a-b)(a+b) = a^2 - b^2",
        "caption": {
          "ru": "Разность квадратов",
          "en": "Difference of squares",
          "tj": "Фарқи квадратҳо"
        }
      },
      {
        "type": "example",
        "problem": {
          "ru": "Вычислите $99^2$ устно.",
          "en": "Compute $99^2$ mentally.",
          "tj": "$99^2$-ро аз ёд ҳисоб кунед."
        },
        "solution": [
          {
            "type": "text",
            "markdown": {
              "ru": "Представим $99$ как $100 - 1$ и применим квадрат разности.",
              "en": "Write $99$ as $100 - 1$ and use the square of a difference.",
              "tj": "$99$-ро ҳамчун $100 - 1$ менависем ва квадрати фарқро истифода мебарем."
            }
          },
          {
            "type": "formula",
            "latex": "99^2 = 100^2 - 2\\cdot100 + 1 = 9801"
          }
        ]
      }
    ]
  }
]