    "title": {
      "ru": "Тригонометрические тождества",
      "en": "Trigonometric identities",
      "tj": "Айниятҳои тригонометрӣ"
    },
    "blocks": [
      {
        "type": "text",
        "markdown": {
          "ru": "Тождества связывают тригонометрические функции одного угла и позволяют упрощать выражения.",
          "en": "Identities relate the trig functions of one angle and let you simplify expressions.",
          "tj": "Айниятҳо функсияҳои тригонометрии як кунҷро мепайванданд ва имкони соддагардониро медиҳанд."
        }
      },
      {
        "type": "table",
        "headers": [
          {
            "ru": "Название",
            "en": "Name",
            "tj": "Ном"
          },
          {
            "ru": "Формула",
            "en": "Formula",
            "tj": "Формула"
          }
        ],
        "rows": [
          [
            {
              "ru": "Основное",
              "en": "Pythagorean",
              "tj": "Асосӣ"
            },
            "$\\sin^2\\alpha + \\cos^2\\alpha = 1$"
          ],
          [
            {
              "ru": "Тангенс",
              "en": "Tangent",
              "tj": "Тангенс"
            },
            "$\\tan\\alpha = \\dfrac{\\sin\\alpha}{\\cos\\alpha}$"
          ],
          [
            {
              "ru": "Синус суммы",
              "en": "Sine of a sum",
              "tj": "Синуси ҷамъ"
            },
            "$\\sin(\\alpha+\\beta) = \\sin\\alpha\\cos\\beta + \\cos\\alpha\\sin\\beta$"
          ],
          [
            {
              "ru": "Косинус суммы",
              "en": "Cosine of a sum",
              "tj": "Косинуси ҷамъ"
            },
            "$\\cos(\\alpha+\\beta) = \\cos\\alpha\\cos\\beta - \\sin\\alpha\\sin\\beta$"
          ],
          [
            {
              "ru": "Двойной угол",
              "en": "Double angle",
              "tj": "Кунҷи дучанд"
            },
            "$\\sin 2\\alpha = 2\\sin\\alpha\\cos\\alpha$"
          ]
        ]
      }
    ]
  }
]