[
  {
    "id": "biology.animal-systems.basics",
    "topicId": "biology.animal-systems",
    "title": {
      "ru": "Системы органов животных",
      "en": "Animal organ systems",
      "tj": "Системаҳои узвҳои ҳайвонот"
    },
    "blocks": [
      {
        "type": "text",
        "markdown": {
          "ru": "Органы животного объединены в **системы**, которые работают согласованно.",
          "en": "An animal's organs are grouped into **systems** that work together.",
          "tj": "Узвҳои ҳайвон ба **системаҳо** муттаҳид шудаанд, ки ҳамоҳанг кор мекунанд."
        }
      },
      {
        "type": "list",
        "items": [
          {
            "ru": "Пищеварительная — переваривает пищу.",
            "en": "Digestive — breaks down food.",
            "tj": "Ҳозима — хӯрокро ҳазм мекунад."
          },
          {
            "ru": "Дыхательная — газообмен.",
            "en": "Respiratory — gas exchange.",
            "tj": "Нафаскашӣ — мубодилаи газ."
          },
          {
            "ru": "Кровеносная — переносит вещества.",
            "en": "Circulatory — transports substances.",
            "tj": "Гардиши хун — моддаҳоро мекашонад."
          },
          {
            "ru": "Нервная — управляет организмом.",
            "en": "Nervous — controls the body.",
            "tj": "Асаб — организмро идора мекунад."
          }
        ]
      },
      {
        "type": "example",
        "problem": {
          "ru": "Какая система переносит питательные вещества по телу?",
          "en": "Which system carries nutrients around the body?",
          "tj": "Кадом система моддаҳои ғизоиро дар бадан мекашонад?"
        },
        "solution": [
          {
            "type": "text",
            "markdown": {
              "ru": "Кровеносная система.",
              "en": "The circulatory system.",
              "tj": "Системаи гардиши хун."
            }
          }
        ]
      }
    ]
  }
]