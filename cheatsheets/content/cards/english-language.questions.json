      "ru": "Типы вопросов",
      "en": "Question types",
      "tj": "Намудҳои савол"
    },
    "blocks": [
      {
        "type": "text",
        "markdown": {
          "ru": "В английском есть несколько **типов вопросов**.",
          "en": "English has several **types of questions**.",
          "tj": "Дар англисӣ якчанд **намуди савол** мавҷуд аст."
        }
      },
      {
        "type": "table",
        "headers": [
          {
            "ru": "Тип",
            "en": "Type",
            "tj": "Намуд"
          },
          {
            "ru": "Структура",
            "en": "Structure",
            "tj": "Сохт"
          },
          {
            "ru": "Пример",
            "en": "Example",
            "tj": "Мисол"
          }
        ],
        "rows": [
          [
            {
              "ru": "Общий",
              "en": "Yes/No",
              "tj": "Умумӣ"
            },
            {
              "ru": "Do/Does/Did + подл. + гл.?",
              "en": "Do/Does/Did + subj. + verb?",
              "tj": "Do/Does/Did + мубтадо + феъл?"
            },
            "Do you like tea?"
          ],
          [
            {
              "ru": "Специальный",
              "en": "Wh-",
              "tj": "Махсус"
            },
            {
              "ru": "Wh- + вспом. + подл. + гл.?",
              "en": "Wh- + aux. + subj. + verb?",
              "tj": "Wh- + ёридиҳанда + мубтадо?"
            },
            "Where do you live?"
          ],
          [
            {
              "ru": "Альтернативный",
              "en": "Alternative",
              "tj": "Алтернативӣ"
            },
            {
              "ru": "… or …?",
              "en": "… or …?",
              "tj": "… ё …?"
            },
            "Do you want tea or coffee?"
          ],
          [
            {
              "ru": "Разделительный",
              "en": "Tag",
              "tj": "Тасдиқӣ-суоли"
            },
            {
              "ru": "утверж. + отриц.тег?",
              "en": "statement + tag?",
              "tj": "тасдиқ + тег?"
            },
            "It's hot, isn't it?"
          ]
        ]
      },
      {
        "type": "example",
        "problem": {
