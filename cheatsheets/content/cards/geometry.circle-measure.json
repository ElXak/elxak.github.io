    "id": "geometry.circle-measure.basics",
    "topicId": "geometry.circle-measure",
    "title": {
      "ru": "Длина окружности и площадь круга",
      "en": "Circumference and area of a circle",
      "tj": "Дарозии давра ва масоҳати доира"
    },
    "blocks": [
      {
        "type": "text",
        "markdown": {
          "ru": "Для окружности радиуса $R$ ($\\pi \\approx 3{,}14$):",
          "en": "For a circle of radius $R$ ($\\pi \\approx 3.14$):",
          "tj": "Барои даврае бо радиуси $R$ ($\\pi \\approx 3{,}14$):"
        }
      },
      {
        "type": "formula",
        "latex": "C = 2\\pi R",
        "caption": {
          "ru": "Длина окружности",
          "en": "Circumference",
          "tj": "Дарозии давра"
        }
      },
      {
        "type": "formula",
        "latex": "S = \\pi R^2",
        "caption": {
          "ru": "Площадь круга",
          "en": "Area of a disk",
          "tj": "Масоҳати доира"
        }
      },
      {
        "type": "example",
        "problem": {
          "ru": "Радиус $R = 5$. Найдите длину окружности и площадь круга.",
          "en": "Radius $R = 5$. Find the circumference and the area.",
          "tj": "Радиус $R = 5$. Дарозии давра ва масоҳати доираро ёбед."
        },
        "solution": [
          {
            "type": "formula",
            "latex": "C = 10\\pi,\\quad S = 25\\pi"
          }
        ]
      }
    ]
  }
]