[
  {
    "id": "geometry.volumes.basics",
    "topicId": "geometry.volumes",
    "title": {
      "ru": "Объёмы тел",
      "en": "Volumes of solids",
      "tj": "Ҳаҷми ҷисмҳо"
    },
    "blocks": [
      {
        "type": "text",
        "markdown": {
          "ru": "Объём измеряется в кубических единицах. Здесь $S$ — площадь основания, $h$ — высота, $R$ — радиус.",
          "en": "Volume is measured in cubic units. Here $S$ is the base area, $h$ the height, $R$ the radius.",
          "tj": "Ҳаҷм бо воҳидҳои кубӣ чен мешавад. Дар ин ҷо $S$ — масоҳати асос, $h$ — баландӣ, $R$ — радиус."
        }
      },
      {
        "type": "table",
        "headers": [
          {
            "ru": "Тело",
            "en": "Solid",
            "tj": "Ҷисм"
          },
          {
            "ru": "Объём",
            "en": "Volume",
            "tj": "Ҳаҷм"
          }
        ],
        "rows": [
          [
            {
              "ru": "Призма",
              "en": "Prism",
              "tj": "Призма"
            },
            "$V = S\\,h$"
          ],
          [
            {
              "ru": "Цилиндр",
              "en": "Cylinder",
              "tj": "Силиндр"
            },
            "$V = \\pi R^2 h$"
          ],
          [
            {
              "ru": "Пирамида",
              "en": "Pyramid",
              "tj": "Пирамида"
            },
            "$V = \\dfrac{1}{3}S\\,h$"
          ],
          [
            {
              "ru": "Конус",
              "en": "Cone",
              "tj": "Конус"
            },
            "$V = \\dfrac{1}{3}\\pi R^2 h$"
          ],
          [
            {
              "ru": "Шар",
              "en": "Sphere",
              "tj": "Кура"
            },
            "$V = \\dfrac{4}{3}\\pi R^3$"
          ]
        ]
      },
      {
        "type": "example",
        "problem": {
          "ru": "Найдите объём шара радиуса $R = 3$.",
          "en": "Find the volume of a sphere of radius $R = 3$.",
          "tj": "Ҳаҷми кураи радиуси $R = 3$-ро ёбед."
        },
        "solution": [
          {
            "type": "formula",
            "latex": "V = \\dfrac{4}{3}\\pi \\cdot 27 = 36\\pi"
          }
        ]
      }
    ]
  }
