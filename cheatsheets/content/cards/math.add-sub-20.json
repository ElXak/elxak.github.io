    "title": {
      "ru": "Сложение и вычитание в пределах 20",
      "en": "Addition and subtraction within 20",
      "tj": "Ҷамъ ва тарҳ дар доираи 20"
    },
    "blocks": [
      {
        "type": "text",
        "markdown": {
          "ru": "Складываем и вычитаем, переходя через десяток.",
          "en": "We add and subtract, crossing over ten.",
          "tj": "Ҷамъ ва тарҳро бо гузаштан аз даҳӣ иҷро мекунем."
        }
      },
      {
        "type": "example",
        "problem": {
          "ru": "Сколько будет $8 + 5$?",
          "en": "What is $8 + 5$?",
          "tj": "$8 + 5$ чанд мешавад?"
        },
        "solution": [
          {
            "type": "text",
            "markdown": {
              "ru": "Сначала до 10: $8 + 2 = 10$, потом $+3$.",
              "en": "First to 10: $8 + 2 = 10$, then $+3$.",
              "tj": "Аввал то 10: $8 + 2 = 10$, баъд $+3$."
            }
          },
          {
            "type": "formula",
            "latex": "8 + 5 = 13"
          }
        ]
      },
      {
        "type": "example",
        "problem": {
          "ru": "Сколько будет $15 - 6$?",
          "en": "What is $15 - 6$?",
          "tj": "$15 - 6$ чанд мешавад?"
        },
        "solution": [
          {
            "type": "formula",
            "latex": "15 - 6 = 9"
          }
        ]
      }
    ]
  }
