[
  {
    "id": "physics.mass-density.basics",
    "topicId": "physics.mass-density",
    "title": {
      "ru": "Масса и плотность",
      "en": "Mass and density",
      "tj": "Масса ва зичӣ"
    },
    "blocks": [
      {
        "type": "text",
        "markdown": {
          "ru": "**Масса** ($m$, кг) — мера количества вещества. **Плотность** показывает массу единицы объёма.",
          "en": "**Mass** ($m$, kg) measures the amount of matter. **Density** is the mass of a unit volume.",
          "tj": "**Масса** ($m$, кг) — ченаки миқдори модда. **Зичӣ** массаи воҳиди ҳаҷмро нишон медиҳад."
        }
      },
      {
        "type": "formula",
        "latex": "\\rho = \\dfrac{m}{V}",
        "caption": {
          "ru": "плотность, кг/м³",
          "en": "density, kg/m³",
          "tj": "зичӣ, кг/м³"
        }
      },
      {
        "type": "example",
        "problem": {
          "ru": "$m = 200$ г, $V = 100$ см³. Найдите плотность.",
          "en": "$m = 200$ g, $V = 100$ cm³. Find the density.",
          "tj": "$m = 200$ г, $V = 100$ см³. Зичиро ёбед."
        },
        "solution": [
          {
            "type": "text",
            "markdown": {
              "ru": "$\\rho = \\dfrac{200}{100} = 2$ г/см³.",
              "en": "$\\rho = \\dfrac{200}{100} = 2$ g/cm³.",
              "tj": "$\\rho = \\dfrac{200}{100} = 2$ г/см³."
            }
          }
        ]
      }
    ]
  }
]