    "title": {
      "ru": "Законы Ньютона",
      "en": "Newton's laws",
      "tj": "Қонунҳои Нютон"
    },
    "blocks": [
      {
        "type": "list",
        "items": [
          {
            "ru": "**1-й закон:** тело сохраняет покой или равномерное движение, если на него не действуют силы (инерция).",
            "en": "**1st law:** a body stays at rest or in uniform motion unless a force acts on it (inertia).",
            "tj": "**Қонуни 1-ум:** ҷисм оромӣ ё ҳаракати мунтазамро нигоҳ медорад, агар ба он қувва таъсир накунад (инерсия)."
          },
          {
            "ru": "**2-й закон:** ускорение пропорционально силе: $F = ma$.",
            "en": "**2nd law:** acceleration is proportional to force: $F = ma$.",
            "tj": "**Қонуни 2-ум:** шитоб ба қувва мутаносиб аст: $F = ma$."
          },
          {
            "ru": "**3-й закон:** действие равно противодействию.",
            "en": "**3rd law:** action equals reaction.",
            "tj": "**Қонуни 3-ум:** таъсир ба аксуламал баробар аст."
          }
        ]
      },
      {
        "type": "formula",
        "latex": "F = ma",
        "caption": {
          "ru": "сила, Н",
          "en": "force, N",
          "tj": "қувва, Н"
        }
      },
      {
        "type": "example",
        "problem": {
          "ru": "$m = 2$ кг, $a = 3$ м/с². Найдите силу.",
          "en": "$m = 2$ kg, $a = 3$ m/s². Find the force.",
          "tj": "$m = 2$ кг, $a = 3$ м/с². Қувваро ёбед."
        },
        "solution": [
          {
            "type": "text",
            "markdown": {
              "ru": "$F = 2 \\times 3 = 6$ Н.",
              "en": "$F = 2 \\times 3 = 6$ N.",
              "tj": "$F = 2 \\times 3 = 6$ Н."
            }
          }
        ]
      }
    ]
  }
]